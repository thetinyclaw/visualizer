    P1A --> P1B --> P1C --> P1D
  end

  G1{{"GATE 1<br/>recognizable topology + motion<br/>human visual sign-off"}}

  subgraph P2["PHASE 2 · WEBGPU CORE + HERO EFFECTS"]
    direction TB
    P2A["WebGPU Foundation<br/>capability probe · device lifecycle · fallback"]
    P2B["Render Graph<br/>compute · geometry · depth · feedback · post"]
    P2C["Audio Feature Bus<br/>16 bands · flux · onset · envelopes"]
    P2D["Hero Effect Ports<br/>persistent strands · 3D shards · instanced voxels"]
    P2E["Runtime Integration<br/>scene manifests · transitions · telemetry"]
    P2A --> P2B --> P2D --> P2E
    P2C --> P2D
  end

  G2{{"GATE 2<br/>native density · stable frame pacing<br/>structural audio response · browser QA"}}

  subgraph P3["PHASE 3 · PRODUCTION + CONTINUOUS EVOLUTION"]
    direction TB
    P3A["Curated Migration<br/>upgrade winners · retain WebGL legacy library"]
    P3B["Automated Candidate Factory<br/>reference brief · isolated prototype · comparison"]
    P3C["Regression System<br/>motion sheets · frame metrics · device matrix"]
    P3D["Release Operations<br/>versioned scenes · rollback · HTTPS deployment"]
    P3A --> P3B --> P3C --> P3D
  end

  G3{{"GATE 3<br/>curated release approval<br/>no autonomous self-acceptance"}}
  LIVE["Visualizer v4<br/>high-fidelity live library"]

  SRC --> P1A
  P1D --> G1
  G1 -- "pass" --> P2A
  G1 -- "revise topology" --> P1B
  P2E --> G2
  G2 -- "pass" --> P3A
  G2 -- "optimize / repair" --> P2B
  P3D --> G3
  G3 -- "release" --> LIVE
  G3 -- "reject / branch" --> P3B

  subgraph ACCEPT["NON-BYPASSABLE ACCEPTANCE LOOP · EVERY EFFECT"]
    direction LR
    NOTE["Every phase submission<br/>must enter this loop"] -->
    A1["1 · Provenance<br/>rights + source inventory"] -->
    A2["2 · Topology Proof<br/>grayscale silhouette + projection"] -->
    A3["3 · Motion Proof<br/>camera + temporal coherence"] -->
    A4["4 · Material Pass<br/>light + color + depth"] -->
    A5["5 · Audio Pass<br/>structure, not brightness"] -->
    A6["6 · Evidence<br/>side-by-side motion sheet + telemetry"] -->
    A7{{"7 · Human Approval"}}
    A7 -- "fail" --> A2
  end

  G3 -. "same acceptance loop applies at Gates 1–3" .-> NOTE

